# Local only: copy to .env. Never commit credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=60
MAX_MODEL_STEPS=8
MAX_TOOL_CALLS=12
# bm25 works offline. Dense/hybrid require a configured semantic encoder.
RETRIEVAL_STRATEGY=bm25
EMBEDDING_BACKEND=onnx
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EVIDENCEFLOW_API_URL=http://127.0.0.1:8000
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

